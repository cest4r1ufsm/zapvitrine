# Copiar para deploy/.env.runtime; chmod 600. Valores de exemplo NAO sao credenciais.
APP_URL=https://app.seu-dominio.example
DATABASE_URL=postgresql://agt_app:SUBSTITUIR_HEX_DO_ARQUIVO_POSTGRES_APP@postgres:5432/agtgestor?connection_limit=8&pool_timeout=10
REDIS_URL=rediss://:SUBSTITUIR_HEX_DO_ARQUIVO_REDIS@redis:6379
JWT_SECRET=SUBSTITUIR_POR_SEGREDO_FORTE_DE_64_CARACTERES
MEDIA_STORAGE=s3
AWS_REGION=sa-east-1
MEDIA_BUCKET=SUBSTITUIR_BUCKET_EXISTENTE
MEDIA_PUBLIC_URL=https://cdn.seu-dominio.example
# VPS fora da AWS precisa credenciais IAM restritas ao bucket/public/*.
AWS_ACCESS_KEY_ID=SUBSTITUIR
AWS_SECRET_ACCESS_KEY=SUBSTITUIR
META_APP_ID=
META_APP_SECRET=
META_SIGNUP_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_TOKEN_ENCRYPTION_KEY=
# META_GRAPH_VERSION=VERSAO_HOMOLOGADA_NO_APP_META
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Integrações opcionais só ficam ativas com credenciais reais homologadas.
